# Server port (Render sets this automatically)
PORT=4000

# Allowed origin for CORS when frontend is hosted separately (use * for testing)
CORS_ORIGIN=*

# Secret key required to view RSVP responses via GET /api/rsvp (X-Admin-Key header)
ADMIN_KEY=change-me

# Google Apps Script Web App URL that appends each RSVP to your Google Sheet.
# Leave blank to disable Google Sheets forwarding (RSVPs still save to data/rsvps.json).
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwDFwHZdDVBmrfuC47CELKTwtoG-R0zITu02dsmEvxn_NPLgH7DiS8AOl8K5fhQbl0NWA/exec

# Optional shared secret; must match the SECRET constant inside your Apps Script.
SHEETS_WEBHOOK_SECRET=
